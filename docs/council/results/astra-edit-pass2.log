      if (e.key === 'Escape') { closePanel(); return; }
      if (e.key === 'Tab') {
        var f = focusables(); if (!f.length) { e.preventDefault(); panel.focus(); return; }
        var first = f[0], last = f[f.length - 1];
        if (e.shiftKey && (document.activeElement === first || document.activeElement === panel)) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });
    document.addEventListener('focusin', function (e) {
      if (panelOpen && !panel.contains(e.target)) { (closeBtn || panel).focus(); }
    });
    /* hide the tab while the Inquire ground or the footer is in view */
    var hideFor = [$('#inquire'), $('.site-footer')].filter(Boolean);
    if (hideFor.length && 'IntersectionObserver' in window) {
      var inView = new Map();
      var tabObserver = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { inView.set(en.target, en.isIntersecting); });
        var any = false;
        inView.forEach(function (v) { if (v) { any = true; } });
        tab.classList.toggle('is-hidden', any);
        tab.setAttribute('aria-hidden', any ? 'true' : 'false');
        tab.tabIndex = any ? -1 : 0;
      }, { threshold: 0.05 });
      hideFor.forEach(function (el) { tabObserver.observe(el); });
    }
  }

  /* Same-page anchors (including "index.html#inquire" while on index):
     the panel and the drawer close first, then the scroll. */
  $$('a[href*="#"]').forEach(function (a) {
    a.addEventListener('click', function (e) {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || a.target === '_blank') { return; }
      var url = new URL(a.getAttribute('href'), location.href);
      var norm = function (p) { return p.replace(/\/index\.html$/, '/'); };
      if (url.origin !== location.origin || norm(url.pathname) !== norm(location.pathname) || !url.hash) { return; }
      var target = document.getElementById(url.hash.slice(1));
      if (!target) { return; }
      e.preventDefault();
      closeNav();
      closePanel();
      scrollToEl(target);
      history.pushState(null, '', url.hash);
    });
  });
  if (location.hash) {
    var landing = document.getElementById(location.hash.slice(1));
    if (landing) { setTimeout(function () { scrollToEl(landing); }, 80); }
  }

  /* ---------------------------------------------------------
     Accordion (The celebrations): hover expands on pointer
     devices, click/focus expands (touch, keyboard). Each trigger
     controls its body (aria-controls / id). On <=768px every body
     is shown stacked and the triggers are removed (CSS + here).
     --------------------------------------------------------- */
  $$('[data-accordion]').forEach(function (acc, ai) {
    var panels = $$('.accordion__panel', acc);
    var hoverable = window.matchMedia('(hover: hover)').matches;
    function open(target) {
      panels.forEach(function (p) {
        var on = p === target;
        p.classList.toggle('is-open', on);
        var btn = $('.accordion__trigger', p);
        if (btn) { btn.setAttribute('aria-expanded', on ? 'true' : 'false'); }
        var content = $('.accordion__body', p);
        if (content) { content.inert = !on; content.setAttribute('aria-hidden', on ? 'false' : 'true'); }
      });
    }
    panels.forEach(function (p, i) {
      var btn = $('.accordion__trigger', p);
      var bodyEl = $('.accordion__body', p);
      if (bodyEl && !bodyEl.id) { bodyEl.id = 'acc-' + ai + '-' + i; }
      if (btn && bodyEl) { btn.setAttribute('aria-controls', bodyEl.id); }
      /* hover opens unless the keyboard placed focus inside the accordion (a click also focuses, and must not disable hover) */
      if (hoverable) { p.addEventListener('mouseenter', function () { if (isDesktop() && !(usingKeyboard && acc.contains(document.activeElement))) { open(p); } }); }
      if (btn) {
        btn.addEventListener('click', function () { if (isDesktop()) { open(p); } });
        btn.addEventListener('focus', function () { if (isDesktop()) { open(p); } });
      }
    });
    var syncMobile = function () {
      var mobile = !isDesktop();
      panels.forEach(function (p) {
        var btn = $('.accordion__trigger', p);
        var content = $('.accordion__body', p);
        var visible = mobile || p.classList.contains('is-open');
        if (!mobile && content && content.contains(document.activeElement)) { open(p); visible = true; }
        if (content) { content.inert = !visible; content.setAttribute('aria-hidden', visible ? 'false' : 'true'); }
        if (!btn) { return; }
        btn.hidden = mobile;
        if (mobile) { btn.setAttribute('aria-expanded', 'true'); }
        else { btn.setAttribute('aria-expanded', p.classList.contains('is-open') ? 'true' : 'false'); }
      });
    };
    syncMobile();
    desktopQuery.addEventListener('change', syncMobile);
  });
  html.classList.add('site-ready');

  /* ---------------------------------------------------------
     Inquiry form: posts to Formspree with fetch when available;
     12 s AbortController timeout; entered values stay on every
     error (timeout included); the submit button is restored in
     finally; the aria-live region reports success / error.
     Without fetch the form submits normally.
     --------------------------------------------------------- */
  var form = $('.form[data-ajax]');
  if (form && window.fetch && window.FormData) {
    var status = $('.form__status', form) || $('#form-status');
    var submitBtn = $('button[type="submit"]', form);
    var say = function (kind, text) {
      if (!status) { return; }
      status.hidden = false;
      status.className = 'form__status is-' + kind;
      status.textContent = text;
    };
    var restoreSubmit = function () { if (submitBtn) { submitBtn.disabled = false; } };
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      if (/FORMSPREE_ID/.test(form.action)) {
        say('error', 'Online inquiries are not connected yet. Your entries are still here. Please write to hello@anarevents.com or WhatsApp us.');
        return;
      }
      if (submitBtn && submitBtn.disabled) { return; }
      if (submitBtn) { submitBtn.disabled = true; }
      say('wait', 'Sendingâ€¦');
      var controller = (typeof AbortController !== 'undefined') ? new AbortController() : null;
      var timedOut = false;
      var timer = setTimeout(function () { timedOut = true; if (controller) { controller.abort(); } }, 12000);
      var options = { method: 'POST', body: new FormData(form), headers: { 'Accept': 'application/json' } };
      if (controller) { options.signal = controller.signal; }
      var request = fetch(form.action, options)
        .then(function (r) { if (!r.ok) { throw new Error('bad status'); } })
        .then(function () {
          say('ok', 'Thank you. Your message is on its way; we reply within one business day.');
          form.reset();
          if (status) { status.focus(); }
        })
        .catch(function () {
          if (timedOut) {
            say('error', 'The connection timed out before your message was sent. Nothing you typed was lost: please try again in a moment, or write to hello@anarevents.com or WhatsApp us.');
          } else {
            say('error', 'Your message did not send. Nothing you typed was lost: please try again, or write to hello@anarevents.com or WhatsApp us.');
          }
          if (status) { status.focus(); }
        });
      var done = function () { clearTimeout(timer); restoreSubmit(); };
      if (request.finally) { request.finally(done); } else { request.then(done, done); }
    });
  }

  /* =========================================================
     MOTION. initMotion() builds every tween and returns true;
     killMotion() removes them all and shows everything. The
     "Pause motion / Play motion" button and the reduced-motion
     media query call these.
     ========================================================= */
  var motionOn = false;
  var leafTweens = [];
  var trunkImgs = $$('.descend__trunks img');

  /* Keyboard focus inside a reveal target: mark every animated ancestor
     .is-revealed at once (CSS forces it visible) so nobody tabs into
     invisible content. The inquiry form carries no reveal class at all. */
  document.addEventListener('focusin', function (e) {
    var node = e.target;
    if (!node || !node.closest || !html.classList.contains('anim-ready')) { return; }
    while (node && node !== body) {
      if (node.classList.contains('reveal') || node.classList.contains('reveal-img') || node.classList.contains('stagger') ||
          (node.parentElement && node.parentElement.classList.contains('stagger'))) {
        node.classList.add('is-revealed');
      }
      node = node.parentElement;
    }
  });

  function initMotion() {
    if (!hasGsap || motionOn) { return motionOn; }
    try {
      gsap.registerPlugin(ScrollTrigger);
      html.classList.add('anim-ready');
      html.classList.add('motion');
      html.classList.remove('reduced');
      buildTweens();
      motionOn = true;
      ScrollTrigger.refresh();
    } catch (err) {
      killMotion();
      stopSmoothScroll();
      /* nothing stays hidden if init fails */
      html.classList.remove('anim-ready');
      html.classList.remove('motion');
      html.classList.add('reduced');
      motionOn = false;
      if (window.console) { console.warn('Anar motion disabled:', err); }
    }
    return motionOn;
  }

  function killMotion() {
    try {
      if (hasGsap) {
      ScrollTrigger.getAll().forEach(function (st) { st.kill(); });
      leafTweens.forEach(function (t) { t.kill(); });
      leafTweens = [];
      gsap.globalTimeline.clear();
      $$('.reveal, .reveal-img, .stagger > *, .hero__mark, .hero__canopy, .hero__deepen, .hero__scroll, .hero__tag, .descend__trunks img, .teaser__strips i, .leaf, .ground__roots, .track-dot, .kashida-draw path, .track-line path')
        .forEach(function (el) { gsap.set(el, { clearProps: 'all' }); });
      }
    } catch (e) { /* ignore */ }
    html.classList.remove('anim-ready');
    html.classList.remove('motion');
    html.classList.add('reduced');
    motionOn = false;
  }

  function buildTweens() {
    /* -------------------------------------------------------
       1. HERO (scrubbed over the hero's own height): the logo
          rises slower than the page and fades (no blur: cheaper);
          the video tint deepens to solid cypress;
       2. the canopy-u3 piece moves up and out at 0.6x scroll speed.
       ------------------------------------------------------- */
    var hero = $('.hero');
    if (hero) {
      gsap.timeline({
        scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true, invalidateOnRefresh: true }
      })
        .to('.hero__mark', { y: function () { return vh() * 0.45; }, opacity: 0.35, ease: 'none', duration: 1 }, 0)
        .to('.hero__canopy', { y: function () { return vh() * 0.4; }, ease: 'none', duration: 1 }, 0)
        .to('.hero__deepen', { opacity: 1, ease: 'none', duration: 1 }, 0)
        .to(['.hero__scroll', '.hero__tag'], { opacity: 0, ease: 'none', duration: 0.35 }, 0);
    }

    /* -------------------------------------------------------
       3. DESCEND THE TREE: the two edge strips (trunk-left /
          trunk-right) sit in a sticky, viewport-high frame and
          scroll past at 0.8x while the statement and the pillars
          (normal flow) pass at 1x. Travel is clamped to each
          strip's spare height so no gap opens at the bottom.
       ------------------------------------------------------- */
    var descend = $('.descend');
    if (descend && trunkImgs.length) {
      trunkImgs.forEach(function (img) {
        gsap.to(img, {
          y: function () {
            var travel = Math.max(0, descend.offsetHeight - vh()) * 0.8;
            var room = Math.max(0, img.offsetHeight - vh());
            return -Math.min(travel, room);
          },
          ease: 'none',
          scrollTrigger: { trigger: descend, start: 'top top', end: 'bottom bottom', scrub: true, invalidateOnRefresh: true }
        });
      });
    }

    /* -------------------------------------------------------
       4. Kashida draw-on: every .kashida-draw path draws with
          scroll (stroke-dashoffset from full length to 0)
       ------------------------------------------------------- */
    $$('.kashida-draw path').forEach(function (p) {
      var len = p.getTotalLength();
      p.style.strokeDasharray = len;
      p.style.strokeDashoffset = len;
      gsap.to(p, {
        strokeDashoffset: 0, ease: 'none',
        scrollTrigger: { trigger: p.closest('svg'), start: 'top 88%', end: 'top 45%', scrub: true }
      });
    });

    /* -------------------------------------------------------
       5. The journey (and the steps line on How we work):
          [data-track] holds .track-line path(s) and .track-dot(s).
          The sage base line and all the dots are there from the
          start (CSS: no empty state); the gold .track-line overlay
          draws across with scroll and each dot turns gold, with a
          small pulse, as the line reaches it.
       ------------------------------------------------------- */
    $$('[data-track]').forEach(function (track) {
      var paths = $$('.track-line path', track);
      var dots = $$('.track-dot', track);
      if (!paths.length) { return; }
      var tl = gsap.timeline({
        scrollTrigger: { trigger: track, start: 'top 78%', end: 'bottom 60%', scrub: true }
      });
      paths.forEach(function (p) {
        var len = p.getTotalLength();
        p.style.strokeDasharray = len;
        p.style.strokeDashoffset = len;
        tl.to(p, { strokeDashoffset: 0, ease: 'none', duration: 1 }, 0);
      });
      dots.forEach(function (d, i) {
        var at = Math.max(0, (i + 0.5) / dots.length - 0.04);
        tl.fromTo(d, { backgroundColor: '#5D625F' }, { backgroundColor: '#C99E5C', ease: 'none', duration: 0.05 }, at);
        tl.fromTo(d, { scale: 1 }, { scale: 1.35, ease: 'power1.inOut', duration: 0.03, yoyo: true, repeat: 1 }, at);
      });
    });

    /* -------------------------------------------------------
       6. How we work teaser: three gold kashida strips slide in
          from the right as the section arrives, then the cards.
       ------------------------------------------------------- */
    var teaser = $('.teaser');
    if (teaser) {
      var strips = $$('.teaser__strips i', teaser);
      gsap.timeline({ scrollTrigger: { trigger: teaser, start: 'top 75%', end: 'top 20%', scrub: true } })
        .fromTo(strips, { xPercent: 102 }, { xPercent: 0, ease: 'power1.inOut', duration: 0.6, stagger: 0.15 }, 0);
    }

    /* -------------------------------------------------------
       7. The roots: roots-floor rises in as the floor while the
          Inquire section arrives.
       ------------------------------------------------------- */
    var ground = $('.ground'), roots = $('.ground__roots');
    if (ground && roots) {
      gsap.fromTo(roots, { yPercent: 28 }, {
        yPercent: 0, ease: 'none',
        scrollTrigger: { trigger: ground, start: 'top 90%', end: 'top 15%', scrub: true }
      });
    }

    /* -------------------------------------------------------
       8. Floating leaves drift slowly (two places).
       ------------------------------------------------------- */
    $$('.leaf').forEach(function (leaf, i) {
      leafTweens.push(gsap.to(leaf, { y: 18 + i * 6, x: i % 2 ? -10 : 10, rotation: i % 2 ? -3 : 3, duration: 6 + i * 1.5, ease: 'sine.inOut', yoyo: true, repeat: -1 }));
      gsap.to(leaf, { y: '+=' + (40 + i * 10), ease: 'none', scrollTrigger: { trigger: leaf.parentElement, start: 'top bottom', end: 'bottom top', scrub: true } });
    });

    /* -------------------------------------------------------
       9. Section reveals (fade + rise, 0.9s ease-out), once;
          images scale 1.02 -> 1; .stagger children stagger.
          Anything already inside the viewport is shown at once
          (no flash: .anim-ready and these sets land in one task).
       ------------------------------------------------------- */
    var limit = vh() * 0.88;
    var seen = function (el) { return el.getBoundingClientRect().top < limit; };
    $$('.reveal').forEach(function (el) {
      if (seen(el)) { gsap.set(el, { opacity: 1, y: 0 }); return; }
      gsap.to(el, { opacity: 1, y: 0, duration: 0.9, ease: 'power2.out', scrollTrigger: { trigger: el, start: 'top 88%', once: true } });
    });
    $$('.reveal-img').forEach(function (el) {
      if (seen(el)) { gsap.set(el, { scale: 1 }); return; }
      gsap.to(el, { scale: 1, duration: 1.2, ease: 'power2.out', scrollTrigger: { trigger: el, start: 'top 88%', once: true } });
    });
    $$('.stagger').forEach(function (group) {
      if (seen(group)) { gsap.set(group.children, { opacity: 1, y: 0 }); return; }
      gsap.to(group.children, { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out', stagger: 0.08, scrollTrigger: { trigger: group, start: 'top 88%', once: true } });
    });
  }

  /* ---------------------------------------------------------
     Pause motion / Play motion (bottom-left ghost button) and
     the prefers-reduced-motion change event.
     --------------------------------------------------------- */
  var toggle = $('.motion-toggle');
  /* the visible text lives in .motion-toggle__text (hidden on desktop, where CSS draws the glyph);
     the accessible name is the fixed aria-label "Motion" and is never changed here */
  var toggleText = toggle ? ($('.motion-toggle__text', toggle) || toggle) : null;
  var setToggle = function (pressed) {
    if (!toggle) { return; }
    toggle.setAttribute('aria-pressed', pressed ? 'true' : 'false');
    toggleText.textContent = pressed ? 'Play motion' : 'Pause motion';
  };
  function pauseAll(remember) {
    if (remember) { userPaused = true; }
    if (remember) { try { sessionStorage.setItem('anar-motion', 'paused'); } catch (e) { /* ignore */ } }
    killMotion();
    stopSmoothScroll();
    if (heroVideo && !heroVideo.paused) { heroVideo.pause(); }
    setToggle(true);
  }
  function playAll(remember) {
    userPaused = false;
    if (remember) { try { sessionStorage.removeItem('anar-motion'); } catch (e) { /* ignore */ } }
    if (reduced) { pauseAll(false); return; }
    startSmoothScroll();
    if (body.classList.contains('panel-open') && lenis) { lenis.stop(); }
    initMotion();
    if (heroVideo) { if (!videoLoaded) { loadHeroVideo(); } else if (heroVideo.getBoundingClientRect().bottom > 0) { heroVideo.play().catch(function () {}); } }
    setToggle(false);
  }
  if (toggle) {
    toggle.hidden = !hasGsap && !heroVideo;
    if (!toggle.hasAttribute('aria-label')) { toggle.setAttribute('aria-label', 'Motion'); }
    toggle.addEventListener('click', function () { if (userPaused || reduced) { playAll(true); } else { pauseAll(true); } });
    /* phones: the toggle hides (CSS .is-hidden under 768px) once the hero (or the inner-page band) has scrolled out */
    var heroEl = $('.hero') || $('.pageband');
    if (heroEl && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { toggle.classList.toggle('is-hidden', !en.isIntersecting); });
      }, { threshold: 0 }).observe(heroEl);
    }
  }
  var onReduceChange = function (e) {
    reduced = e.matches;
    if (reduced) { pauseAll(false); } else if (!userPaused) { playAll(false); }
  };
  if (rmq.addEventListener) { rmq.addEventListener('change', onReduceChange); } else if (rmq.addListener) { rmq.addListener(onReduceChange); }

  /* ---- start ---- */
  if (!hasGsap || reduced || userPaused) {
    html.classList.add('reduced');
    if (toggle && (userPaused || reduced)) { setToggle(true); }
  } else {
    initMotion();
  }

  /* Refresh once fonts and images have settled (sticky heights, line lengths) */
  if (hasGsap) {
    window.addEventListener('load', function () { if (motionOn) { ScrollTrigger.refresh(); } });
    if (document.fonts && document.fonts.ready) { document.fonts.ready.then(function () { if (motionOn) { ScrollTrigger.refresh(); } }); }
    trunkImgs.forEach(function (img) { if (!img.complete) { img.addEventListener('load', function () { if (motionOn) { ScrollTrigger.refresh(); } }); } });
  }
})();
/* =========================================================
   Anar Events â€” site.css (v2, night palette, 3 Nov 2026)
   One file. Mobile first. No grid hairlines anywhere.
   Latin: TT Ramillas Bold only (TRIAL font: buy before launch).
   Persian: Noto Naskh Arabic (Google Fonts), never italic/tracked/caps.
   ========================================================= */

/* ---------- Fonts ---------- */
@font-face{font-family:"TT Ramillas";src:url("../fonts/TTRamillas-Bold.woff2") format("woff2");font-weight:700;font-style:normal;font-display:swap}

/* ---------- Tokens ---------- */
:root{
  /* night palette (priority) */
  --night:#1B221E;     /* cypress night: page ground, video tint */
  --deep:#121714;      /* deep night: bands */
  --parch:#F9F6F0;     /* silk parchment: text on night */
  --gold:#C99E5C;      /* zaffaran gold: logo, accents, the one button */
  --ruby:#6D1A24;      /* Kashan ruby: secondary accent, hover */
  --sage:#5D625F;      /* captions on parchment */
  --stone:#B9B3A6;     /* captions on night */
  /* day palette (light interludes only) */
  --cream:#F0E6D5;
  --brown:#432617;
  --red:#9E1B32;

  --tint:rgba(27,34,30,.58);
  --font-latin:"TT Ramillas",Georgia,"Times New Roman",serif;
  --font-fa:"Noto Naskh Arabic",Tahoma,serif;

  --s1:8px;--s2:16px;--s3:32px;--s4:64px;
  --container:1140px;
  --narrow:760px;
  --gutter:20px;
  --header-h:64px;
  --ease:cubic-bezier(.22,.61,.36,1);
  --dur:.9s;
}
@media (min-width:768px){
  :root{--gutter:clamp(40px,6vw,96px);--header-h:88px}
}

/* ---------- Reset-ish ---------- */
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth;background:var(--night)}
html.lenis{scroll-behavior:auto}
html.reduced{scroll-behavior:auto}
[id]{scroll-margin-top:calc(var(--header-h) + 16px)}
body{margin:0;background:var(--night);color:var(--parch);font-family:var(--font-latin);font-weight:700;font-size:18px;line-height:28px;overflow-x:hidden}
img,video,svg{display:block;max-width:100%}
img{height:auto}
h1,h2,h3,h4,p,ul,ol,figure,blockquote{margin:0}
ul,ol{padding:0;list-style:none}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer}
:focus{outline:none}
:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
.on-light :focus-visible,.on-light:focus-visible{outline-color:var(--ruby)}
.visually-hidden{position:absolute!important;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
.skip-link{position:absolute;left:var(--s2);top:-80px;z-index:100;background:var(--gold);color:var(--night);padding:var(--s1) var(--s2);border-radius:999px}
.skip-link:focus{top:var(--s2)}
::selection{background:var(--gold);color:var(--night)}

/* ---------- Type ---------- */
h1,h2,h3,h4{font-weight:700;line-height:1.1}
.h-display{font-size:clamp(40px,7vw,80px);line-height:1.02}
h2,.h-headline{font-size:clamp(30px,4vw,44px);line-height:1.12}
h3{font-size:clamp(22px,2.6vw,28px);line-height:1.2}
.eyebrow{font-size:14px;line-height:20px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold)}
.on-light .eyebrow{color:var(--ruby)}
.caption{font-size:14px;line-height:20px;color:var(--stone)}
.on-light .caption{color:var(--sage)}
.lede{font-size:clamp(20px,2.2vw,24px);line-height:1.45}
.fa,[lang="fa"]{font-family:var(--font-fa);font-style:normal!important;letter-spacing:0!important;text-transform:none!important;font-weight:400;font-size:115%;line-height:1.7;direction:rtl;unicode-bidi:isolate}
.fa--big{font-size:clamp(26px,4.2vw,40px);line-height:1.5}
.fa--title{font-size:clamp(34px,5.4vw,60px);line-height:1.4}
.measure{max-width:38em}
.muted{color:var(--stone)}
.on-light .muted{color:var(--sage)}
.center{text-align:center}

/* ---------- Layout ---------- */
.container{width:100%;max-width:var(--container);margin-inline:auto;padding-inline:var(--gutter)}
.container--text{max-width:calc(var(--narrow) + 2*var(--gutter))}
main{position:relative;z-index:2;display:block}
.section{position:relative;padding-block:clamp(72px,12vh,150px)}
.section--tight{padding-block:clamp(48px,7vh,88px)}
.section__head{text-align:center;margin-bottom:clamp(32px,6vh,72px)}
.section__head .kashida{margin:var(--s2) auto 0}
.pair{display:grid;gap:var(--s1)}
@media (min-width:768px){
  .pair{grid-template-columns:1fr 1fr;align-items:baseline}
  .pair .fa{text-align:right}
}
.band{background:var(--deep)}
.on-light{background:var(--parch);color:var(--night)}
.on-light.on-light--day{background:var(--cream);color:var(--brown)}

/* ---------- Devices ---------- */
/* the kashida line: 2px gold, drawn on by scroll (.kashida-draw) */
.kashida{width:100%;height:2px;overflow:visible;display:block}
.kashida path{fill:none;stroke:var(--gold);stroke-width:2;vector-effect:non-scaling-stroke;stroke-linecap:butt}
.kashida--short{width:min(320px,70vw)}
.on-light .kashida path{stroke:var(--ruby)}
.rule{height:2px;background:var(--gold);width:100%;border:0;margin:0}
.on-light .rule{background:var(--ruby)}
/* the glow band: plain deep cypress with one soft radial gold glow at 6% (the lattice tile read as a grid and is gone) */
.band--glow{position:relative;isolation:isolate}
.band--glow::before{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;background:radial-gradient(ellipse at center,rgba(201,158,92,.06),rgba(201,158,92,0) 70%)}

/* ---------- Buttons: ONE gold button, ruby on hover ---------- */
.btn{display:inline-block;padding:14px 30px;border:2px solid var(--gold);background:var(--gold);color:var(--night);font-weight:700;line-height:1;letter-spacing:.02em;border-radius:999px;transition:transform .3s var(--ease),background .3s,color .3s,border-color .3s;white-space:nowrap}
.btn:hover{background:var(--ruby);border-color:var(--ruby);color:var(--parch);transform:translateY(-2px)}
.btn:focus-visible{outline-color:var(--parch)}
.on-light .btn:focus-visible{outline-color:var(--ruby)}
.btn--sm{padding:10px 20px;font-size:16px}
.link{border-bottom:2px solid var(--gold);padding-bottom:2px;transition:color .3s,border-color .3s}
.link:hover{color:var(--gold);border-color:var(--ruby)}
.on-light .link{border-color:var(--ruby)}
.on-light .link:hover{color:var(--ruby)}

/* ---------- Header (shared) ---------- */
.site-header{position:absolute;top:0;left:0;right:0;z-index:50;height:var(--header-h);color:var(--parch);transition:background .4s,box-shadow .4s}
.js .site-header{position:fixed}
.site-header__inner{height:100%;display:flex;align-items:center;gap:var(--s2);padding-inline:clamp(16px,3vw,40px)}
/* the small gold logo: fades in (.4s) once the page is scrolled, on every page; always on inner pages */
.nav-home{display:block;width:120px;margin-right:var(--s2);flex:0 0 auto;opacity:0;visibility:hidden;transition:opacity .4s,visibility .4s}
.nav-home img{width:100%;height:auto}
.site-header--solid .nav-home,.site-header.is-scrolled .nav-home{opacity:1;visibility:visible}
/* the links are visible by default; on phones they collapse into the drawer only once site.js has bound
   the toggle (html.nav-ready). Until then they sit in a deep-night strip under the bar and the toggle is hidden. */
.site-nav{display:block}
.site-nav ul{display:flex;flex-wrap:wrap;gap:clamp(16px,2.4vw,36px)}
@media (max-width:767px){
  html:not(.nav-ready) .site-nav{position:absolute;top:var(--header-h);left:0;right:0;background:var(--deep);border-top:2px solid var(--gold);padding:var(--s2) var(--gutter)}
  html:not(.nav-ready) .nav-toggle{visibility:hidden}
  html.nav-ready .site-nav{display:none}
}
.site-nav a{display:inline-block;padding-block:4px;border-bottom:2px solid transparent;transition:border-color .3s,color .3s;letter-spacing:.02em}
.site-nav a:hover,.site-nav a[aria-current="page"]{border-bottom-color:var(--gold)}
.nav-right{margin-left:auto;display:flex;align-items:center;gap:clamp(12px,2vw,28px)}
/* ÙØ§Ø±Ø³ÛŒ Â· Ø¨Ù‡â€ŒØ²ÙˆØ¯ÛŒ: an inert stone label (no title / aria-label); the "soon" drops under the word on phones */
.nav-fa{font-size:20px;line-height:1;color:var(--stone);cursor:default;text-align:center}
.nav-fa__soon{font-size:14px}
@media (max-width:767px){.nav-fa{font-size:18px}.nav-fa__soon{display:block;font-size:12px;line-height:1.3;margin-top:2px}}
.nav-toggle{width:44px;height:44px;display:grid;place-items:center;margin-left:-8px}
.nav-toggle__bar{display:block;width:24px;height:2px;background:currentColor;position:relative;transition:background .2s}
.nav-toggle__bar::before,.nav-toggle__bar::after{content:"";position:absolute;left:0;width:24px;height:2px;background:currentColor;transition:transform .3s}
.nav-toggle__bar::before{top:-8px}.nav-toggle__bar::after{top:8px}
.nav-toggle[aria-expanded="true"] .nav-toggle__bar{background:transparent}
.nav-toggle[aria-expanded="true"] .nav-toggle__bar::before{transform:translateY(8px) rotate(45deg)}
.nav-toggle[aria-expanded="true"] .nav-toggle__bar::after{transform:translateY(-8px) rotate(-45deg)}
/* mobile drawer */
.site-header.nav-open{background:var(--deep)}
html.nav-ready .site-header.nav-open .site-nav{display:block;position:absolute;top:var(--header-h);left:0;right:0;background:var(--deep);border-top:2px solid var(--gold);padding:var(--s3) var(--gutter) var(--s4)}
.site-header.nav-open .site-nav ul{flex-direction:column;gap:var(--s2)}
.site-header.nav-open .site-nav a{font-size:26px}
/* solid once scrolled, and on inner pages */
.site-header--solid,.site-header.is-scrolled{background:rgba(27,34,30,.92)}
@supports (backdrop-filter:blur(8px)){.site-header--solid,.site-header.is-scrolled{backdrop-filter:blur(8px)}}
@media (min-width:768px){
  .nav-toggle{display:none}
  .nav-home{width:150px}
}
.page-top{padding-top:var(--header-h)}

/* ---------- HERO (index first screen, approved 02:05) ---------- */
.hero{position:relative;height:100vh;height:100svh;min-height:600px;overflow:hidden;background:var(--night);color:var(--parch)}
.hero__video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;background:var(--night) url("../video/hero-poster-small.jpg") center/cover}
.hero__tint{position:absolute;inset:0;background:var(--tint);pointer-events:none}
.hero__deepen{position:absolute;inset:0;background:var(--night);opacity:0;pointer-events:none}
/* the ONE tree piece: anchored low, width 100vw (or 140vh on tall screens), top at ~35% so the canopy
   rises ~37% at the sides and ~15% in the centre; trunks half off the page; bottom runs off-screen */
.hero__canopy{position:absolute;left:50%;top:35%;width:max(100%,140vh);max-width:none;height:auto;transform:translateX(-50%);pointer-events:none;will-change:transform}
/* logo with the soft cypress halo behind it (a static radial gradient: no filter:blur) */
.hero__mark{position:absolute;left:50%;top:28%;width:min(51vw,980px);transform:translateX(-50%);will-change:transform,opacity}
.hero__halo{position:absolute;left:50%;top:50%;width:150%;height:220%;transform:translate(-50%,-50%);background:radial-gradient(closest-side,rgba(27,34,30,.6),transparent 70%);pointer-events:none}
.hero__logo{position:relative;margin:0;line-height:0}
.hero__logo img{width:100%;height:auto}
.hero__line{position:relative;margin:clamp(12px,1.6vh,20px) auto 0;text-align:center;color:var(--parch);font-size:clamp(12px,1.1vw,15px);line-height:1.5;letter-spacing:.08em;text-transform:uppercase;opacity:.92}
/* bottom-left sits 64px up so the "Pause motion" button never covers it */
.hero__scroll{position:absolute;left:clamp(16px,3vw,40px);bottom:calc(clamp(16px,3vh,32px) + 64px);font-size:14px;line-height:20px;letter-spacing:.12em;text-transform:uppercase;color:var(--parch);opacity:.9}
.hero__tag{position:absolute;right:clamp(16px,3vw,40px);bottom:clamp(14px,2.6vh,28px);font-size:22px;line-height:1.4;color:var(--parch);text-align:right}
@media (max-width:768px){
  .hero__canopy{width:140vw;top:auto;bottom:-4%}
  .hero__mark{width:78vw;top:30%}
  .hero__line{font-size:12px;letter-spacing:.06em;padding-inline:4px}
  /* the "How we work +" tab is now a mid-height edge tab on phones too: the tagline stays at the bottom */
}

/* ---------- Floating leaves (two places; static under reduced motion) ---------- */
.leaf{position:absolute;z-index:0;width:220px;height:250px;background:url("../tree/leaves-float.webp") no-repeat;background-size:1376px 768px;pointer-events:none;opacity:.9}
.leaf--1{background-position:-100px -70px}
.leaf--3{background-position:-690px -50px}
@media (max-width:768px){.leaf{transform:scale(.6);transform-origin:top left}}

/* ---------- DESCEND THE TREE ---------- */
.descend{position:relative;background:var(--night);overflow:clip;--descend-col:880px}
.descend__trunks{position:sticky;top:0;height:100vh;height:100svh;overflow:hidden;pointer-events:none;z-index:0}
/* two edge strips (trunk-left / trunk-right, transparent webp), never behind the centre column:
   20vw each from 1024px, 26vw at 769-1023px, phones keep only the left strip at 34vw.
   The paint reaches inward across most of each strip, so above 768px the mask fades out exactly at
   the column edge, max((100vw - 880px)/2, gutter): no painted art under the text at any width. */
.descend__trunk{position:absolute;top:0;width:20vw;max-width:20vw;height:auto;min-height:100%;object-fit:cover;will-change:transform}
.descend__trunk--l{left:0;object-position:left top;-webkit-mask-image:linear-gradient(to right,#000 70%,transparent);mask-image:linear-gradient(to right,#000 70%,transparent)}
.descend__trunk--r{right:0;object-position:right top;-webkit-mask-image:linear-gradient(to left,#000 70%,transparent);mask-image:linear-gradient(to left,#000 70%,transparent)}
@media (min-width:769px){
  .descend__trunk--l{-webkit-mask-image:linear-gradient(to right,#000 min(70%,calc(max((100vw - var(--descend-col)) / 2,var(--gutter)) - 32px)),transparent min(100%,calc(max((100vw - var(--descend-col)) / 2,var(--gutter)))));mask-image:linear-gradient(to right,#000 min(70%,calc(max((100vw - var(--descend-col)) / 2,var(--gutter)) - 32px)),transparent min(100%,calc(max((100vw - var(--descend-col)) / 2,var(--gutter)))))}
  .descend__trunk--r{-webkit-mask-image:linear-gradient(to left,#000 min(70%,calc(max((100vw - var(--descend-col)) / 2,var(--gutter)) - 32px)),transparent min(100%,calc(max((100vw - var(--descend-col)) / 2,var(--gutter)))));mask-image:linear-gradient(to left,#000 min(70%,calc(max((100vw - var(--descend-col)) / 2,var(--gutter)) - 32px)),transparent min(100%,calc(max((100vw - var(--descend-col)) / 2,var(--gutter)))))}
}
@media (min-width:769px) and (max-width:1023px){.descend__trunk{width:26vw;max-width:26vw}}
@media (max-width:768px){.descend__trunk{width:34vw;max-width:34vw}.descend__trunk--r{display:none}}
.descend__content{position:relative;z-index:1;margin-top:-100vh;margin-top:-100svh;padding-block:clamp(72px,14vh,170px) clamp(72px,12vh,150px)}
.descend__content .container--text{max-width:calc(var(--descend-col) + 2*var(--gutter))}
.descend .leaf--1{right:4vw;top:12vh;z-index:1}
.statement{text-align:center}
.statement .kashida--short{margin:var(--s2) auto var(--s3)}
.statement__text{font-size:clamp(24px,3.6vw,48px);line-height:1.2;letter-spacing:.05em;text-transform:uppercase;color:var(--parch);max-width:20em;margin-inline:auto}
.statement__line{display:block}
.statement__sub{margin-top:var(--s3);color:var(--stone);font-size:18px;line-height:28px;max-width:34em;margin-inline:auto}

/* three pillars as cards */
.pillars{display:grid;gap:var(--s2);margin-top:clamp(56px,10vh,120px)}
@media (min-width:768px){.pillars{grid-template-columns:repeat(3,1fr);gap:var(--s3)}}
/* cards: a 2px gold top rule only (no perimeter border) */
.card{position:relative;background:rgba(18,23,20,.82);border:0;border-top:2px solid var(--gold);padding:var(--s3) var(--s3) var(--s3);display:grid;gap:var(--s2);align-content:start;transition:transform .35s var(--ease);will-change:transform}
.card:hover{transform:translateY(-4px)}
.card__n{display:block;font-size:14px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold)}
.card__n .fa{display:inline;font-size:18px;color:var(--parch);letter-spacing:0}
.card p{color:var(--parch)}
.card p.muted{color:var(--stone);font-size:16px;line-height:24px}

/* ---------- The celebrations: accordion ---------- */
.accordion{display:grid;gap:var(--s2)}
.accordion__panel{position:relative;overflow:hidden;background:var(--deep);color:var(--parch);border-radius:2px;min-height:360px}
.accordion__media{position:absolute;inset:0}
.accordion__media img{width:100%;height:100%;object-fit:cover;transition:filter .6s var(--ease),transform .6s var(--ease)}
.accordion__media::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(18,23,20,.92) 0%,rgba(18,23,20,.45) 50%,rgba(27,34,30,.25) 100%)}
.accordion__trigger{position:absolute;inset:0;width:100%;text-align:left;z-index:2}
.accordion__trigger[hidden]{display:none}
.accordion__trigger:focus-visible{outline:2px solid var(--gold);outline-offset:-6px}
.accordion__label{position:absolute;left:var(--s2);top:var(--s2);letter-spacing:.1em;text-transform:uppercase;font-size:14px;z-index:1;display:none;color:var(--gold)}
.accordion__body{position:relative;z-index:3;padding:var(--s4) var(--s2) var(--s3);display:grid;gap:var(--s1);min-height:100%;align-content:end;pointer-events:none}
.accordion__body h3{font-size:clamp(26px,3vw,38px)}
.accordion__body .fa{color:var(--gold)}
.accordion__body p:last-child{max-width:34em;color:var(--parch)}
.accordion__more{pointer-events:auto;margin-top:var(--s1);justify-self:start}
@media (min-width:769px){
  .accordion{display:flex;gap:var(--s1);height:min(70vh,640px)}
  .accordion__panel{flex:1 1 0;min-height:0;transition:flex .7s var(--ease)}
  .accordion__panel.is-open{flex:6 1 0}
  .accordion__panel:not(.is-open) .accordion__media img{filter:blur(6px) brightness(.75);transform:scale(1.08)}
  /* collapsed bodies leave the accessibility tree (visibility:hidden after the fade) */
  .accordion__panel:not(.is-open) .accordion__body{opacity:0;visibility:hidden;transition:opacity .25s,visibility 0s .25s}
  .accordion__panel.is-open .accordion__body{opacity:1;visibility:visible;transition:opacity .6s .25s,visibility 0s}
  .accordion__panel:not(.is-open) .accordion__label{display:block;writing-mode:vertical-rl;left:auto;right:50%;top:auto;bottom:var(--s3);transform:translateX(50%) rotate(180deg)}
  .accordion__body{padding:var(--s4) var(--s4) var(--s4)}
}

/* ---------- Founder quote: the light interlude (parchment) ---------- */
.quote{text-align:center}
.quote blockquote{font-size:clamp(22px,3vw,36px);line-height:1.3;max-width:30em;margin-inline:auto;text-wrap:balance}
.quote blockquote span{display:block}
.quote blockquote .quote__key{color:var(--ruby)}
/* "Medi, founder" as an eyebrow line in ruby (the founder attribution on parchment; no drawn signature) */
.quote figcaption.quote__by{margin-top:var(--s3);color:var(--ruby)}

/* ---------- How we work teaser (glow band, gold strips, two cards, two service options) ---------- */
.teaser{overflow:hidden}
/* the two service options (index teaser and How we work "What you get"): 2px gold top rule, when support begins, three responsibilities */
.options{display:grid;gap:var(--s3)}
@media (min-width:768px){.options{grid-template-columns:1fr 1fr;gap:var(--s4)}}
.teaser .options{margin-top:var(--s4)}
.options > li{border-top:2px solid var(--gold);padding-top:var(--s2);display:grid;gap:var(--s1);align-content:start}
.options h3{font-size:clamp(20px,2.2vw,24px)}
.options .option__when{color:var(--gold);font-size:14px;line-height:20px;letter-spacing:.06em;text-transform:uppercase}
.options p,.options ul{color:var(--stone);font-size:16px;line-height:24px}
.options ul{display:grid;gap:4px}
.options ul li{padding-left:18px;position:relative}
.options ul li::before{content:"";position:absolute;left:0;top:11px;width:8px;height:2px;background:var(--gold)}
.teaser__strips{position:relative;height:2px;margin-block:var(--s3) var(--s4);display:grid;gap:0}
.teaser__strips i{position:absolute;left:0;right:0;height:2px;background:var(--gold);transform-origin:right center}
.teaser__strips i:nth-child(1){top:-14px;opacity:.9}
.teaser__strips i:nth-child(2){top:0}
.teaser__strips i:nth-child(3){top:14px;opacity:.6}
.anim-ready .teaser__strips i{transform:translateX(102%)}
.teaser__grid{display:grid;gap:var(--s3)}
@media (min-width:768px){.teaser__grid{grid-template-columns:1fr 1fr;gap:var(--s4)}}
.teaser .card h3{font-size:clamp(28px,3.4vw,40px)}
.teaser__foot{margin-top:var(--s4);text-align:center;color:var(--stone);font-size:16px;line-height:24px}

/* ---------- The journey: nine stops on one gold line ---------- */
.journey{position:relative}
.journey .leaf--3{left:2vw;top:8vh;z-index:0}
.journey__order{text-align:center;color:var(--stone);font-size:16px;line-height:24px;max-width:38em;margin:calc(-1 * clamp(16px,3vh,40px)) auto clamp(32px,6vh,72px);text-wrap:balance}
.journey__track{position:relative;z-index:1}
.journey__line{position:absolute;pointer-events:none}
/* the full line is there at once in sage at 35%; the gold .track-line overlay draws across it with scroll */
.journey__line path{fill:none;stroke:var(--sage);stroke-opacity:.35;stroke-width:2;vector-effect:non-scaling-stroke}
.journey__line.track-line path{stroke:var(--gold);stroke-opacity:1}
.journey__line--h{display:none}
.journey__line--v{left:11px;top:0;width:2px;height:100%}
.journey__stops{display:grid;gap:var(--s3);padding-left:40px}
.journey__stop{position:relative;display:grid;gap:2px}
/* all nine dots show at once (sage); site.js block 5 turns each gold as the line reaches it */
.journey__dot{position:absolute;left:-40px;top:10px;width:14px;height:14px;border-radius:50%;background:var(--sage);transform-origin:center}
.journey__en{color:var(--parch);font-size:15px;line-height:20px;text-wrap:balance}
.journey__fa{font-size:16px;line-height:1.6;text-align:left;direction:rtl;color:var(--stone)}
.journey__note{font-size:13px;line-height:18px;color:var(--stone)}
@media (min-width:900px){
  .journey__line--h{display:block;left:0;right:0;top:7px;width:100%;height:2px}
  .journey__line--v{display:none}
  .journey__stops{grid-template-columns:repeat(9,minmax(0,1fr));gap:var(--s1);padding-left:0;padding-top:var(--s4)}
  .journey__stop{text-align:center;justify-items:center}
  .journey__dot{left:50%;top:-64px;margin-left:-7px}
  .journey__fa{text-align:center}
}

/* ---------- The roots and the floor; Inquire sits on the ground ---------- */
.ground{position:relative;overflow:hidden;background:var(--night)}
.ground__roots{position:absolute;left:50%;bottom:-2%;width:max(100%,120vh);max-width:none;height:auto;transform:translateX(-50%);pointer-events:none;z-index:0;will-change:transform}
@media (max-width:768px){.ground__roots{width:150vw}}
.ground .container{position:relative;z-index:1}
.inquire{padding-block:clamp(72px,12vh,150px) clamp(24vw,28vw,520px)}
@media (min-width:768px){.inquire{padding-bottom:clamp(220px,22vw,420px)}}
.inquire__contact{display:flex;flex-wrap:wrap;gap:var(--s2) var(--s3);margin-top:var(--s3);color:var(--stone);font-size:16px;line-height:24px}
.inquire__contact a{color:var(--parch);user-select:all;-webkit-user-select:all;border-bottom:2px solid rgba(201,158,92,.5)}
.inquire__contact a:hover{border-color:var(--gold)}
.inquire__contact a.wa{user-select:auto;-webkit-user-select:auto}

/* ---------- Form: a 2px gold top rule only ---------- */
.form{display:grid;gap:var(--s3);background:rgba(18,23,20,.78);border:0;border-top:2px solid var(--gold);padding:clamp(20px,4vw,48px)}
.form__row{display:grid;gap:var(--s3)}
@media (min-width:600px){.form__row{grid-template-columns:1fr 1fr}}
.field{display:grid;gap:var(--s1);min-width:0}
.field label,.fieldset legend{font-size:16px;line-height:22px;color:var(--parch)}
.field input,.field textarea,.field select{font:inherit;font-weight:700;color:var(--parch);background:transparent;border:1px solid var(--stone);border-radius:2px;padding:12px 14px;width:100%;min-height:48px}
/* placeholders in stone (#B9B3A6 on the deep input ground: ~8:1) */
.field input::placeholder,.field textarea::placeholder{color:var(--stone);opacity:1}
.field input:focus-visible,.field textarea:focus-visible,.field select:focus-visible{outline:2px solid var(--gold);outline-offset:2px;border-color:var(--gold)}
.field input[type="date"],.field select{color-scheme:dark}
.field select{appearance:none;-webkit-appearance:none;background-image:linear-gradient(45deg,transparent 50%,var(--gold) 50%),linear-gradient(135deg,var(--gold) 50%,transparent 50%);background-position:calc(100% - 22px) 50%,calc(100% - 16px) 50%;background-size:6px 6px,6px 6px;background-repeat:no-repeat;padding-right:44px;cursor:pointer}
.field select option{background:var(--deep);color:var(--parch)}
/* success / error region (aria-live) */
.form__status{font-size:16px;line-height:24px;padding:var(--s2);border-top:2px solid var(--gold);color:var(--parch)}
.form__status[hidden]{display:none}
.form__status:empty{padding:0;border:0;height:0;margin-top:calc(-1 * var(--s3))}
.form__status.is-error{border-top-color:var(--ruby)}
.form__status.is-wait{color:var(--stone)}
.form__status:focus{outline:none}
.field textarea{min-height:150px;resize:vertical}
.fieldset{border:0;padding:0;margin:0;min-width:0;display:grid;gap:var(--s1)}
.checks{display:grid;gap:var(--s1) var(--s2);grid-template-columns:1fr 1fr}
@media (min-width:600px){.checks{grid-template-columns:repeat(3,1fr)}}
.check{display:flex;gap:10px;align-items:center;font-size:16px;line-height:22px;min-height:32px}
.check input{width:18px;height:18px;accent-color:var(--gold);margin:0;flex:0 0 auto}
.form__note{font-size:14px;line-height:20px;color:var(--stone)}

/* ---------- Footer (deep night band) ---------- */
.site-footer{background:var(--deep);color:var(--parch);border-top:2px solid var(--gold);padding-block:var(--s4) var(--s3);position:relative;z-index:2}
.site-footer__grid{display:grid;gap:var(--s3)}
@media (min-width:768px){.site-footer__grid{grid-template-columns:1.2fr 1fr 1fr;align-items:start}}
.site-footer__logo{width:min(100%,320px);height:auto}
.site-footer address{font-style:normal;display:grid;gap:4px}
.site-footer address a{border-bottom:2px solid transparent;transition:border-color .3s;width:max-content;max-width:100%}
.site-footer address a:hover{border-color:var(--gold)}
.site-footer__fa{font-size:20px;line-height:1.7;text-align:left;color:var(--gold)}
@media (min-width:768px){.site-footer__fa{text-align:right}}
.site-footer__lang{margin-top:var(--s2);font-size:14px;line-height:20px;color:var(--stone)}
.site-footer__legal{margin-top:var(--s3);font-size:14px;line-height:20px;color:var(--stone);display:flex;flex-wrap:wrap;gap:var(--s2);justify-content:space-between}

/* ---------- Ghost buttons: the "How we work +" tab and "Pause motion" (one gold-filled button per screen) ---------- */
.ghost{background:transparent;border:2px solid var(--gold);color:var(--parch);transition:background .3s,color .3s,border-color .3s,transform .3s var(--ease),opacity .3s}
.ghost:hover,.ghost:focus-visible{background:var(--ruby);border-color:var(--ruby);color:var(--parch)}
.ghost:focus-visible{outline:2px solid var(--parch);outline-offset:3px}
/* the tab: one slim vertical tab at the right edge, mid-height, on every screen size; a solid night
   fill (so it reads as a night object over the parchment sections too) with the 2px gold border;
   hidden (slides out + fades) while #inquire or the footer is in view */
.hww-tab{position:fixed;z-index:60;right:0;top:50%;writing-mode:vertical-rl;transform:translateY(-50%) rotate(180deg);letter-spacing:.06em;padding:20px 12px;border-radius:0 2px 2px 0;border-left:0;background-color:var(--night)}
html:not(.js) .hww-tab{display:none}
.hww-tab.is-hidden{transform:translate(110%,-50%) rotate(180deg);opacity:0;pointer-events:none}
@media (max-width:768px){.hww-tab{padding:14px 8px;font-size:13px;line-height:16px}}
/* Pause motion / Play motion: bottom-left. Phones: a small pill that hides once the hero has scrolled
   out (site.js adds .is-hidden). Desktop: a 40px round icon-only button; the accessible name is the
   fixed aria-label "Motion" and aria-pressed carries the state, so the name never changes. */
.motion-toggle{position:fixed;z-index:60;left:var(--s2);bottom:calc(16px + env(safe-area-inset-bottom));font-size:13px;line-height:18px;letter-spacing:.06em;padding:8px 14px;border-radius:999px;background-color:var(--night)}
.motion-toggle[hidden],html:not(.js) .motion-toggle{display:none}
@media (max-width:768px){.motion-toggle.is-hidden{transform:translateY(140%);opacity:0;pointer-events:none}}
@media (min-width:769px){
  .motion-toggle{width:40px;height:40px;padding:0;border-radius:50%;display:grid;place-items:center;font-family:Georgia,"Segoe UI Symbol","Apple Symbols",serif;font-size:14px;line-height:1;letter-spacing:0}
  .motion-toggle::before{content:"\23F8\FE0E"}
  .motion-toggle[aria-pressed="true"]::before{content:"\25B6\FE0E";padding-left:2px}
  .motion-toggle__text{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
}
.hww-backdrop{position:fixed;inset:0;z-index:70;background:rgba(0,0,0,.55);opacity:0;transition:opacity .4s}
.hww-backdrop[hidden]{display:none}
.hww-backdrop.is-on{opacity:1}
/* the panel is the scrollable element: data-lenis-prevent (HTML) keeps Lenis off its wheel/touch events, overscroll-behavior:contain keeps the page still */
.hww-panel{position:fixed;z-index:80;left:0;right:0;bottom:0;max-height:88vh;overflow:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;background:var(--night);color:var(--parch);padding:var(--s3) var(--s3) var(--s4);border-top:2px solid var(--gold);border-radius:12px 12px 0 0;transform:translateY(100%);transition:transform .55s var(--ease)}
.hww-panel[hidden]{display:none}
.hww-panel.is-open{transform:translateY(0)}
@media (min-width:768px){
  .hww-panel{left:auto;top:0;bottom:0;width:min(540px,92vw);max-height:none;border-top:0;border-left:2px solid var(--gold);border-radius:0;padding:var(--s4);transform:translateX(100%)}
  .hww-panel.is-open{transform:translateX(0)}
}
.hww-panel__close{position:absolute;top:var(--s2);right:var(--s2);width:44px;height:44px;display:grid;place-items:center;font-size:28px;line-height:1;border-radius:50%;color:var(--gold)}
.hww-panel__close:hover{background:rgba(201,158,92,.14)}
.hww-panel h2{margin:var(--s1) 0 var(--s3)}
.hww-steps{display:grid;gap:var(--s2);counter-reset:step;margin-bottom:var(--s3)}
.hww-steps li{display:grid;grid-template-columns:44px 1fr;gap:var(--s2);padding-top:var(--s1)}
.hww-steps li::before{counter-increment:step;content:"0" counter(step);color:var(--gold)}
.hww-steps h3{font-size:20px;line-height:26px;margin-bottom:4px}
.hww-steps p{font-size:16px;line-height:24px;color:var(--stone)}
.hww-panel__foot{display:flex;flex-wrap:wrap;gap:var(--s2) var(--s3);align-items:center}
body.panel-open{overflow:hidden}

/* ---------- Inner page band ---------- */
.pageband{background:var(--deep);padding-block:clamp(56px,10vh,120px) clamp(40px,7vh,80px);border-bottom:2px solid var(--gold)}
.pageband__title{display:grid;gap:var(--s2)}
@media (min-width:768px){.pageband__title{grid-template-columns:1fr 1fr;align-items:end}.pageband__title .fa{text-align:right}}
.pageband .lede{margin-top:var(--s3);color:var(--stone)}

/* ---------- Weddings page ---------- */
.tradition+.tradition{padding-top:clamp(48px,8vh,100px)}
.tradition__grid{display:grid;gap:var(--s3)}
@media (min-width:900px){
  .tradition__grid{grid-template-columns:1fr 1fr;align-items:start;gap:var(--s4)}
  .tradition--flip .tradition__grid > .tradition__text{order:2}
}
.tradition__title{display:grid;gap:var(--s1);margin-bottom:var(--s3)}
@media (min-width:600px){.tradition__title{grid-template-columns:1fr 1fr;align-items:baseline}.tradition__title .fa{text-align:right;color:var(--gold)}}
.tradition__text p+p{margin-top:var(--s2)}
.tradition__media{margin:0}
.tradition__media .slot{overflow:hidden;background:var(--deep);max-width:480px;margin-inline:auto;aspect-ratio:4/5}
.tradition__media .slot img{width:100%;height:100%;object-fit:cover}
.tradition__media figcaption{margin-top:var(--s1);text-align:center}
.seasonal{border-top:2px solid var(--gold);background:rgba(18,23,20,.6);padding:var(--s3)}
.seasonal p+p{margin-top:var(--s2)}

/* ---------- How we work page ---------- */
.steps{position:relative;padding-left:44px}
.steps__list{display:grid;gap:var(--s4)}
.steps__line{position:absolute;left:11px;top:0;width:2px;height:100%}
/* same device as the journey: a sage base line at once, the gold .track-line overlay draws with scroll */
.steps__line path{fill:none;stroke:var(--sage);stroke-opacity:.35;stroke-width:2;vector-effect:non-scaling-stroke}
.steps__line.track-line path{stroke:var(--gold);stroke-opacity:1}
.step{position:relative;display:grid;gap:var(--s1)}
.step__dot{position:absolute;left:-44px;top:10px;width:14px;height:14px;border-radius:50%;background:var(--sage);transform-origin:center}
.step__n{font-size:14px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold)}
.step h3{font-size:clamp(24px,3vw,34px)}
.step .fa{text-align:left;color:var(--gold)}
.step p{color:var(--parch)}
.faq{display:grid;gap:var(--s1);border-top:2px solid var(--ruby);padding-top:var(--s2)}
.faq summary{cursor:pointer;list-style:none;padding:var(--s2) 0;font-size:20px;line-height:28px;display:flex;justify-content:space-between;gap:var(--s2)}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:"+";color:var(--ruby);flex:0 0 auto}
.faq details[open] summary::after{content:"\2013"}
.faq .faq__a{padding:0 0 var(--s3);max-width:38em}
.you-get{display:grid;gap:var(--s3) var(--s3)}
@media (min-width:768px){.you-get{grid-template-columns:1fr 1fr}}
.you-get li{padding-top:0}
.you-get li strong{display:block;color:var(--gold)}
.you-get li span{color:var(--stone);font-size:16px;line-height:24px}

/* ---------- About page ---------- */
.letter{font-size:clamp(20px,2.4vw,28px);line-height:1.45;display:grid;gap:var(--s2)}
.letter__sign{color:var(--ruby);font-size:18px}
/* the founder bio slot under the letter (owner input: bracketed placeholders until Medi writes the lines) */
.letter__bio{margin-top:var(--s3);padding-top:var(--s2);border-top:2px solid var(--ruby);max-width:34em;display:grid;gap:var(--s1);font-size:18px;line-height:28px;color:var(--night)}
.letter__bio .letter__proof{color:var(--ruby);font-size:16px;line-height:24px}
.story__photos{display:grid;gap:var(--s3);margin-top:var(--s3)}
@media (min-width:768px){.story__photos{grid-template-columns:repeat(3,1fr);align-items:end}}
.story__photos figure{margin:0}
.story__photos .slot{overflow:hidden;background:var(--deep);aspect-ratio:3/4}
.story__photos img{width:100%;height:100%;object-fit:cover}
.story__photos figcaption{margin-top:var(--s1)}
.promise{display:grid;gap:var(--s2)}
.promise li{display:grid;grid-template-columns:48px 1fr;gap:var(--s2);border-top:2px solid var(--gold);padding-top:var(--s2);font-size:clamp(20px,2.2vw,26px);line-height:1.4}
.promise li b{color:var(--gold)}
.behaviour{display:grid;gap:var(--s2);grid-template-columns:1fr 1fr;margin-top:var(--s4)}
@media (min-width:768px){.behaviour{grid-template-columns:repeat(4,1fr)}}
.behaviour li{font-size:16px;line-height:24px;padding-top:0;color:var(--stone)}
.behaviour li strong{display:block;color:var(--parch)}

/* ---------- Reveal: content is visible by default. Targets are hidden ONLY under html.anim-ready,
   which site.js adds after GSAP + ScrollTrigger initialised; if that init throws, nothing is hidden. ---------- */
.anim-ready .reveal{opacity:0;transform:translateY(24px)}
.anim-ready .reveal-img{transform:scale(1.02)}
.anim-ready .stagger > *{opacity:0;transform:translateY(16px)}
.reduced .reveal,.reduced .stagger > *{opacity:1;transform:none}
.reduced .reveal-img{transform:none}
.reduced .teaser__strips i{transform:none}
/* keyboard focus inside a reveal target: site.js marks the animated ancestors .is-revealed at once */
.anim-ready .reveal.is-revealed,.anim-ready .reveal-img.is-revealed,.anim-ready .stagger.is-revealed > *,.anim-ready .stagger > .is-revealed{opacity:1!important;transform:none!important}
/* without motion the track is complete: gold line, gold dots */
.reduced .track-line path,html:not(.anim-ready) .track-line path{stroke-dashoffset:0!important}
.reduced .track-dot,html:not(.anim-ready) .track-dot{background:var(--gold)}
.reduced *, .reduced *::before, .reduced *::after{transition-duration:.01ms!important;animation-duration:.01ms!important}
/* Keep all celebrations readable if the behavior script is unavailable. */
html:not(.site-ready) .accordion{display:grid;height:auto}
html:not(.site-ready) .accordion__panel{min-height:360px}
html:not(.site-ready) .accordion__body{opacity:1;visibility:visible}
html:not(.site-ready) .accordion__trigger,html:not(.site-ready) .accordion__label{display:none}

/* ---------- Reduced motion: everything visible, nothing scrubs ---------- */
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{transition-duration:.01ms!important;animation-duration:.01ms!important}
  .anim-ready .reveal,.anim-ready .stagger > *{opacity:1;transform:none}
  .anim-ready .reveal-img{transform:none}
  .anim-ready .teaser__strips i{transform:none}
  .track-line path{stroke-dashoffset:0!important}
  .track-dot{background:var(--gold)}
}

