    if (remember) { try { sessionStorage.setItem('anar-motion', 'paused'); } catch (e) { /* ignore */ } }
    killMotion();
    stopSmoothScroll();
    if (heroVideo && !heroVideo.paused) { heroVideo.pause(); }
    setToggle(true);
  }
  function playAll(remember) {
    userPaused = false;
    if (remember) { try { sessionStorage.removeItem('anar-motion'); } catch (e) { /* ignore */ } }
    if (reduced) { pauseAll(false); return; }
    startSmoothScroll();
    if (body.classList.contains('panel-open') && lenis) { lenis.stop(); }
    initMotion();
    if (heroVideo) { if (!videoLoaded) { loadHeroVideo(); } else if (heroVideo.getBoundingClientRect().bottom > 0) { heroVideo.play().catch(function () {}); } }
    setToggle(false);
  }
  if (toggle) {
    toggle.hidden = !hasGsap && !heroVideo;
    if (!toggle.hasAttribute('aria-label')) { toggle.setAttribute('aria-label', 'Motion'); }
    toggle.addEventListener('click', function () { if (userPaused || reduced) { playAll(true); } else { pauseAll(true); } });
    /* phones: the toggle hides (CSS .is-hidden under 768px) once the hero (or the inner-page band) has scrolled out */
    var heroEl = $('.hero') || $('.pageband');
    if (heroEl && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { toggle.classList.toggle('is-hidden', !en.isIntersecting); });
      }, { threshold: 0 }).observe(heroEl);
    }
  }
  var onReduceChange = function (e) {
    reduced = e.matches;
    if (reduced) { pauseAll(false); } else if (!userPaused) { playAll(false); }
  };
  if (rmq.addEventListener) { rmq.addEventListener('change', onReduceChange); } else if (rmq.addListener) { rmq.addListener(onReduceChange); }

  /* ---- start ---- */
  if (!hasGsap || reduced || userPaused) {
    html.classList.add('reduced');
    if (toggle && (userPaused || reduced)) { setToggle(true); }
  } else {
    initMotion();
  }

  /* Refresh once fonts and images have settled (sticky heights, line lengths) */
  if (hasGsap) {
    window.addEventListener('load', function () { if (motionOn) { ScrollTrigger.refresh(); } });
    if (document.fonts && document.fonts.ready) { document.fonts.ready.then(function () { if (motionOn) { ScrollTrigger.refresh(); } }); }
    trunkImgs.forEach(function (img) { if (!img.complete) { img.addEventListener('load', function () { if (motionOn) { ScrollTrigger.refresh(); } }); } });
  }
})();
/* =========================================================
   Anar Events â€” site.css (v2, night palette, 3 Nov 2026)
   One file. Mobile first. No grid hairlines anywhere.
   Latin: TT Ramillas Bold only (TRIAL font: buy before launch).
   Persian: Noto Naskh Arabic (Google Fonts), never italic/tracked/caps.
   ========================================================= */

/* ---------- Fonts ---------- */
@font-face{font-family:"TT Ramillas";src:url("../fonts/TTRamillas-Bold.woff2") format("woff2");font-weight:700;font-style:normal;font-display:swap}

/* ---------- Tokens ---------- */
:root{
  /* night palette (priority) */
  --night:#1B221E;     /* cypress night: page ground, video tint */
  --deep:#121714;      /* deep night: bands */
  --parch:#F9F6F0;     /* silk parchment: text on night */
  --gold:#C99E5C;      /* zaffaran gold: logo, accents, the one button */
  --ruby:#6D1A24;      /* Kashan ruby: secondary accent, hover */
  --sage:#5D625F;      /* captions on parchment */
  --stone:#B9B3A6;     /* captions on night */
  /* day palette (light interludes only) */
  --cream:#F0E6D5;
  --brown:#432617;
  --red:#9E1B32;

  --tint:rgba(27,34,30,.58);
  --font-latin:"TT Ramillas",Georgia,"Times New Roman",serif;
  --font-fa:"Noto Naskh Arabic",Tahoma,serif;

  --s1:8px;--s2:16px;--s3:32px;--s4:64px;
  --container:1140px;
  --narrow:760px;
  --gutter:20px;
  --header-h:64px;
  --ease:cubic-bezier(.22,.61,.36,1);
  --dur:.9s;
}
@media (min-width:768px){
  :root{--gutter:clamp(40px,6vw,96px);--header-h:88px}
}

/* ---------- Reset-ish ---------- */
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth;background:var(--night)}
html.lenis{scroll-behavior:auto}
html.reduced{scroll-behavior:auto}
[id]{scroll-margin-top:calc(var(--header-h) + 16px)}
body{margin:0;background:var(--night);color:var(--parch);font-family:var(--font-latin);font-weight:700;font-size:18px;line-height:28px;overflow-x:hidden}
img,video,svg{display:block;max-width:100%}
img{height:auto}
h1,h2,h3,h4,p,ul,ol,figure,blockquote{margin:0}
ul,ol{padding:0;list-style:none}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer}
:focus{outline:none}
:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
.on-light :focus-visible,.on-light:focus-visible{outline-color:var(--ruby)}
.visually-hidden{position:absolute!important;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
.skip-link{position:absolute;left:var(--s2);top:-80px;z-index:100;background:var(--gold);color:var(--night);padding:var(--s1) var(--s2);border-radius:999px}
.skip-link:focus{top:var(--s2)}
::selection{background:var(--gold);color:var(--night)}

/* ---------- Type ---------- */
h1,h2,h3,h4{font-weight:700;line-height:1.1}
.h-display{font-size:clamp(40px,7vw,80px);line-height:1.02}
h2,.h-headline{font-size:clamp(30px,4vw,44px);line-height:1.12}
h3{font-size:clamp(22px,2.6vw,28px);line-height:1.2}
.eyebrow{font-size:14px;line-height:20px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold)}
.on-light .eyebrow{color:var(--ruby)}
.caption{font-size:14px;line-height:20px;color:var(--stone)}
.on-light .caption{color:var(--sage)}
.lede{font-size:clamp(20px,2.2vw,24px);line-height:1.45}
.fa,[lang="fa"]{font-family:var(--font-fa);font-style:normal!important;letter-spacing:0!important;text-transform:none!important;font-weight:400;font-size:115%;line-height:1.7;direction:rtl;unicode-bidi:isolate}
.fa--big{font-size:clamp(26px,4.2vw,40px);line-height:1.5}
.fa--title{font-size:clamp(34px,5.4vw,60px);line-height:1.4}
.measure{max-width:38em}
.muted{color:var(--stone)}
.on-light .muted{color:var(--sage)}
.center{text-align:center}

/* ---------- Layout ---------- */
.container{width:100%;max-width:var(--container);margin-inline:auto;padding-inline:var(--gutter)}
.container--text{max-width:calc(var(--narrow) + 2*var(--gutter))}
main{position:relative;z-index:2;display:block}
.section{position:relative;padding-block:clamp(72px,12vh,150px)}
.section--tight{padding-block:clamp(48px,7vh,88px)}
.section__head{text-align:center;margin-bottom:clamp(32px,6vh,72px)}
.section__head .kashida{margin:var(--s2) auto 0}
.pair{display:grid;gap:var(--s1)}
@media (min-width:768px){
  .pair{grid-template-columns:1fr 1fr;align-items:baseline}
  .pair .fa{text-align:right}
}
.band{background:var(--deep)}
.on-light{background:var(--parch);color:var(--night)}
.on-light.on-light--day{background:var(--cream);color:var(--brown)}

/* ---------- Devices ---------- */
/* the kashida line: 2px gold, drawn on by scroll (.kashida-draw) */
.kashida{width:100%;height:2px;overflow:visible;display:block}
.kashida path{fill:none;stroke:var(--gold);stroke-width:2;vector-effect:non-scaling-stroke;stroke-linecap:butt}
.kashida--short{width:min(320px,70vw)}
.on-light .kashida path{stroke:var(--ruby)}
.rule{height:2px;background:var(--gold);width:100%;border:0;margin:0}
.on-light .rule{background:var(--ruby)}
/* the glow band: plain deep cypress with one soft radial gold glow at 6% (the lattice tile read as a grid and is gone) */
.band--glow{position:relative;isolation:isolate}
.band--glow::before{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;background:radial-gradient(ellipse at center,rgba(201,158,92,.06),rgba(201,158,92,0) 70%)}

/* ---------- Buttons: ONE gold button, ruby on hover ---------- */
.btn{display:inline-block;padding:14px 30px;border:2px solid var(--gold);background:var(--gold);color:var(--night);font-weight:700;line-height:1;letter-spacing:.02em;border-radius:999px;transition:transform .3s var(--ease),background .3s,color .3s,border-color .3s;white-space:nowrap}
.btn:hover{background:var(--ruby);border-color:var(--ruby);color:var(--parch);transform:translateY(-2px)}
.btn:focus-visible{outline-color:var(--parch)}
.on-light .btn:focus-visible{outline-color:var(--ruby)}
.btn--sm{padding:10px 20px;font-size:16px}
.link{border-bottom:2px solid var(--gold);padding-bottom:2px;transition:color .3s,border-color .3s}
.link:hover{color:var(--gold);border-color:var(--ruby)}
.on-light .link{border-color:var(--ruby)}
.on-light .link:hover{color:var(--ruby)}

/* ---------- Header (shared) ---------- */
.site-header{position:absolute;top:0;left:0;right:0;z-index:50;height:var(--header-h);color:var(--parch);transition:background .4s,box-shadow .4s}
.js .site-header{position:fixed}
.site-header__inner{height:100%;display:flex;align-items:center;gap:var(--s2);padding-inline:clamp(16px,3vw,40px)}
/* the small gold logo: fades in (.4s) once the page is scrolled, on every page; always on inner pages */
.nav-home{display:block;width:120px;margin-right:var(--s2);flex:0 0 auto;opacity:0;visibility:hidden;transition:opacity .4s,visibility .4s}
.nav-home img{width:100%;height:auto}
.site-header--solid .nav-home,.site-header.is-scrolled .nav-home{opacity:1;visibility:visible}
/* the links are visible by default; on phones they collapse into the drawer only once site.js has bound
   the toggle (html.nav-ready). Until then they sit in a deep-night strip under the bar and the toggle is hidden. */
.site-nav{display:block}
.site-nav ul{display:flex;flex-wrap:wrap;gap:clamp(16px,2.4vw,36px)}
@media (max-width:767px){
  html:not(.nav-ready) .site-nav{position:absolute;top:var(--header-h);left:0;right:0;background:var(--deep);border-top:2px solid var(--gold);padding:var(--s2) var(--gutter)}
  html:not(.nav-ready) .nav-toggle{visibility:hidden}
  html.nav-ready .site-nav{display:none}
}
.site-nav a{display:inline-block;padding-block:4px;border-bottom:2px solid transparent;transition:border-color .3s,color .3s;letter-spacing:.02em}
.site-nav a:hover,.site-nav a[aria-current="page"]{border-bottom-color:var(--gold)}
.nav-right{margin-left:auto;display:flex;align-items:center;gap:clamp(12px,2vw,28px)}
/* ÙØ§Ø±Ø³ÛŒ Â· Ø¨Ù‡â€ŒØ²ÙˆØ¯ÛŒ: an inert stone label (no title / aria-label); the "soon" drops under the word on phones */
.nav-fa{font-size:20px;line-height:1;color:var(--stone);cursor:default;text-align:center}
.nav-fa__soon{font-size:14px}
@media (max-width:767px){.nav-fa{font-size:18px}.nav-fa__soon{display:block;font-size:12px;line-height:1.3;margin-top:2px}}
.nav-toggle{width:44px;height:44px;display:grid;place-items:center;margin-left:-8px}
.nav-toggle__bar{display:block;width:24px;height:2px;background:currentColor;position:relative;transition:background .2s}
.nav-toggle__bar::before,.nav-toggle__bar::after{content:"";position:absolute;left:0;width:24px;height:2px;background:currentColor;transition:transform .3s}
.nav-toggle__bar::before{top:-8px}.nav-toggle__bar::after{top:8px}
.nav-toggle[aria-expanded="true"] .nav-toggle__bar{background:transparent}
.nav-toggle[aria-expanded="true"] .nav-toggle__bar::before{transform:translateY(8px) rotate(45deg)}
.nav-toggle[aria-expanded="true"] .nav-toggle__bar::after{transform:translateY(-8px) rotate(-45deg)}
/* mobile drawer */
.site-header.nav-open{background:var(--deep)}
html.nav-ready .site-header.nav-open .site-nav{display:block;position:absolute;top:var(--header-h);left:0;right:0;background:var(--deep);border-top:2px solid var(--gold);padding:var(--s3) var(--gutter) var(--s4)}
.site-header.nav-open .site-nav ul{flex-direction:column;gap:var(--s2)}
.site-header.nav-open .site-nav a{font-size:26px}
/* solid once scrolled, and on inner pages */
.site-header--solid,.site-header.is-scrolled{background:rgba(27,34,30,.92)}
@supports (backdrop-filter:blur(8px)){.site-header--solid,.site-header.is-scrolled{backdrop-filter:blur(8px)}}
@media (min-width:768px){
  .nav-toggle{display:none}
  .nav-home{width:150px}
}
.page-top{padding-top:var(--header-h)}

/* ---------- HERO (index first screen, approved 02:05) ---------- */
.hero{position:relative;height:100vh;height:100svh;min-height:600px;overflow:hidden;background:var(--night);color:var(--parch)}
.hero__video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;background:var(--night) url("../video/hero-poster-small.jpg") center/cover}
.hero__tint{position:absolute;inset:0;background:var(--tint);pointer-events:none}
.hero__deepen{position:absolute;inset:0;background:var(--night);opacity:0;pointer-events:none}
/* the ONE tree piece: anchored low, width 100vw (or 140vh on tall screens), top at ~35% so the canopy
   rises ~37% at the sides and ~15% in the centre; trunks half off the page; bottom runs off-screen */
.hero__canopy{position:absolute;left:50%;top:35%;width:max(100%,140vh);max-width:none;height:auto;transform:translateX(-50%);pointer-events:none;will-change:transform}
/* logo with the soft cypress halo behind it (a static radial gradient: no filter:blur) */
.hero__mark{position:absolute;left:50%;top:28%;width:min(51vw,980px);transform:translateX(-50%);will-change:transform,opacity}
.hero__halo{position:absolute;left:50%;top:50%;width:150%;height:220%;transform:translate(-50%,-50%);background:radial-gradient(closest-side,rgba(27,34,30,.6),transparent 70%);pointer-events:none}
.hero__logo{position:relative;margin:0;line-height:0}
.hero__logo img{width:100%;height:auto}
.hero__line{position:relative;margin:clamp(12px,1.6vh,20px) auto 0;text-align:center;color:var(--parch);font-size:clamp(12px,1.1vw,15px);line-height:1.5;letter-spacing:.08em;text-transform:uppercase;opacity:.92}
/* bottom-left sits 64px up so the "Pause motion" button never covers it */
.hero__scroll{position:absolute;left:clamp(16px,3vw,40px);bottom:calc(clamp(16px,3vh,32px) + 64px);font-size:14px;line-height:20px;letter-spacing:.12em;text-transform:uppercase;color:var(--parch);opacity:.9}
.hero__tag{position:absolute;right:clamp(16px,3vw,40px);bottom:clamp(14px,2.6vh,28px);font-size:22px;line-height:1.4;color:var(--parch);text-align:right}
@media (max-width:768px){
  .hero__canopy{width:140vw;top:auto;bottom:-4%}
  .hero__mark{width:78vw;top:30%}
  .hero__line{font-size:12px;letter-spacing:.06em;padding-inline:4px}
  /* the "How we work +" tab is now a mid-height edge tab on phones too: the tagline stays at the bottom */
}

/* ---------- Floating leaves (two places; static under reduced motion) ---------- */
.leaf{position:absolute;z-index:0;width:220px;height:250px;background:url("../tree/leaves-float.webp") no-repeat;background-size:1376px 768px;pointer-events:none;opacity:.9}
.leaf--1{background-position:-100px -70px}
.leaf--3{background-position:-690px -50px}
@media (max-width:768px){.leaf{transform:scale(.6);transform-origin:top left}}

/* ---------- DESCEND THE TREE ---------- */
.descend{position:relative;background:var(--night);overflow:clip;--descend-col:880px}
.descend__trunks{position:sticky;top:0;height:100vh;height:100svh;overflow:hidden;pointer-events:none;z-index:0}
/* two edge strips (trunk-left / trunk-right, transparent webp), never behind the centre column:
   20vw each from 1024px, 26vw at 769-1023px, phones keep only the left strip at 34vw.
   The paint reaches inward across most of each strip, so above 768px the mask fades out exactly at
   the column edge, max((100vw - 880px)/2, gutter): no painted art under the text at any width. */
.descend__trunk{position:absolute;top:0;width:20vw;max-width:20vw;height:auto;min-height:100%;object-fit:cover;will-change:transform}
.descend__trunk--l{left:0;object-position:left top;-webkit-mask-image:linear-gradient(to right,#000 70%,transparent);mask-image:linear-gradient(to right,#000 70%,transparent)}
.descend__trunk--r{right:0;object-position:right top;-webkit-mask-image:linear-gradient(to left,#000 70%,transparent);mask-image:linear-gradient(to left,#000 70%,transparent)}
@media (min-width:769px){
  .descend__trunk--l{-webkit-mask-image:linear-gradient(to right,#000 min(70%,calc(max((100vw - var(--descend-col)) / 2,var(--gutter)) - 32px)),transparent min(100%,calc(max((100vw - var(--descend-col)) / 2,var(--gutter)))));mask-image:linear-gradient(to right,#000 min(70%,calc(max((100vw - var(--descend-col)) / 2,var(--gutter)) - 32px)),transparent min(100%,calc(max((100vw - var(--descend-col)) / 2,var(--gutter)))))}
  .descend__trunk--r{-webkit-mask-image:linear-gradient(to left,#000 min(70%,calc(max((100vw - var(--descend-col)) / 2,var(--gutter)) - 32px)),transparent min(100%,calc(max((100vw - var(--descend-col)) / 2,var(--gutter)))));mask-image:linear-gradient(to left,#000 min(70%,calc(max((100vw - var(--descend-col)) / 2,var(--gutter)) - 32px)),transparent min(100%,calc(max((100vw - var(--descend-col)) / 2,var(--gutter)))))}
}
@media (min-width:769px) and (max-width:1023px){.descend__trunk{width:26vw;max-width:26vw}}
@media (max-width:768px){.descend__trunk{width:34vw;max-width:34vw}.descend__trunk--r{display:none}}
.descend__content{position:relative;z-index:1;margin-top:-100vh;margin-top:-100svh;padding-block:clamp(72px,14vh,170px) clamp(72px,12vh,150px)}
.descend__content .container--text{max-width:calc(var(--descend-col) + 2*var(--gutter))}
.descend .leaf--1{right:4vw;top:12vh;z-index:1}
.statement{text-align:center}

